# 复制成 .env 再改。docker compose 会自动读取同目录下的 .env。
#
# 本地开发也一样：vite.config.ts 会把 .env 注入 process.env，
# 所以 `npm run dev` 和容器里的行为一致。

# ---------------------------------------------------------------- 数据库 ---
# 用 DATABASE_URL 一个变量搞定，或者用下面的分项配置（二选一，DATABASE_URL 优先）
# DATABASE_URL=mysql://yuejian:密码@mariadb:3306/yuejian

DB_HOST=mariadb
DB_PORT=3306
DB_NAME=yuejian
DB_USER=yuejian
# 改成你自己的强密码 —— 这个值同时用于 mariadb 容器初始化
DB_PASSWORD=change-me-db-password
# MariaDB 的 root 密码，只在本机维护时用得到，不对外暴露
DB_ROOT_PASSWORD=change-me-root-password
# 连接池大小，一般不用改
DB_POOL_SIZE=10

# ------------------------------------------------------------------ 后台 ---
# 管理后台地址是 /admin。首次部署务必改掉下面两项。
ADMIN_USER=admin
ADMIN_PASSWORD=admin@123
# 会话签名密钥，留空则由 ADMIN_PASSWORD 派生（改密码即失效所有会话）。
# 想更稳妥就填一个 32 位以上的随机串：openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------------ 站点 ---
# 生成分享链接用的域名。留空则从请求头推断（nginx 反代下通常没问题）；
# 如果反代改写了 Host，或者你用多个域名访问，就显式填上。
PUBLIC_BASE_URL=https://your-domain.com

# 容器对外暴露的端口，nginx 反代到这个端口
APP_PORT=3000
# 绑定的网卡。默认只绑回环 —— 宿主机上的 nginx 是唯一入口。
# 如果你的 nginx 跑在另一个容器里，改成 0.0.0.0。
APP_BIND=127.0.0.1

# 是否信任 X-Forwarded-For。前面挂了 nginx 就保持 true；
# 如果把应用端口直接暴露到公网（没有反代），必须改成 false，
# 否则访客可以伪造这个头来污染访问记录。
TRUST_PROXY=true
# 应用前面有几层可信代理。nginx 直连就是 1（默认）。
# 如果还套了 Cloudflare 之类的 CDN，要相应加 1，否则记到的是 CDN 的 IP。
TRUSTED_PROXY_HOPS=1

# 站点走 HTTPS 后建议改成 true，让后台会话 Cookie 只在加密连接上发送
COOKIE_SECURE=false
